# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wagering_db
DB_POOL_MIN=2
DB_POOL_MAX=20

# Messaging (AWS SQS via LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Workers & Scheduling
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_MAX_RETRIES=5
