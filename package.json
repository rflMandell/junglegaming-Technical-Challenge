{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor for iGaming with PostgreSQL and AWS SQS",
  "main": "src/main.ts",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target node --packages=external",
    "start": "bun dist/main.js",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun test test/load",
    "lint": "bunx biome check src test || true",
    "migration:create": "bunx mikro-orm migration:create",
    "migration:up": "bunx mikro-orm migration:up",
    "migration:down": "bunx mikro-orm migration:down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.758.0",
    "@mikro-orm/core": "^6.4.8",
    "@mikro-orm/migrations": "^6.4.8",
    "@mikro-orm/postgresql": "^6.4.8",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.5.0",
    "nestjs-pino": "^4.3.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.8",
    "@nestjs/testing": "11.0.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.2.4",
    "typescript": "^5.8.2"
  }
}
